# 只服务本机 `bun dev`。复制一份填本地地址：
#   cp .env.example .env
#
# 部署用的值不在这里：测试 / 生产（以及本地部署的容器）烤进产物的公开地址来自 unio-deploy 仓库
# environments/<env>/<role>/env/docs-web.env，由 unio-deploy/scripts/build.sh 在构建镜像时传入；
# 本文件与 .env 已被 .dockerignore 排除，不会进镜像。只放非机密参数，绝不要写 token 或密码。

# 文档站自身地址（canonical / sitemap 用）。
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:18520

# 控制台地址（「工作台」入口链接）。
NEXT_PUBLIC_CONSOLE_URL=http://127.0.0.1:18522

# 对外推理入口（文档中的示例代码）。
NEXT_PUBLIC_API_ORIGIN=http://127.0.0.1:8520

# 营销官网地址（顶栏「官网」链接）。
NEXT_PUBLIC_WEBSITE_URL=http://127.0.0.1:18523
