# 环境文件规范：.env.dev（本地开发）/ .env.test（测试服务器）/ .env.prod（生产），
# 由 package.json 的 dotenv -e 显式加载；只放非机密部署参数。

# 文档站自身地址（canonical / sitemap 用）。
NEXT_PUBLIC_SITE_URL=https://docs.unioapi.com

# 控制台地址（「工作台」入口链接）。
NEXT_PUBLIC_CONSOLE_URL=https://console.unioapi.com

# 对外推理入口（文档中的示例代码）。
NEXT_PUBLIC_API_ORIGIN=https://api.unioapi.com
# 营销官网地址（顶栏「官网」链接）。
NEXT_PUBLIC_WEBSITE_URL=https://unioapi.com
